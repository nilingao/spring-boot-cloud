<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.com.nla</groupId>
        <artifactId>nla-modules</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>nla-callcenter</artifactId>
    <description>呼叫中心业务模块：网关/路由/平台等管理域 CRUD、协议 SPI 实现与 FreeSWITCH XML 拉取，算法底座为 nla-common-freeswitch（迁移自旧 spring-boot-fs）</description>
    <dependencies>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-freeswitch</artifactId>
        </dependency>
        <!-- 坐席 Socket.IO 事件推送，由 socket-io.enabled 与 freeswitch.enabled 双开时装配 -->
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-socketio</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-json</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-mybatis</artifactId>
            <exclusions>
                <!-- Redis/lock4j 间接携带 Boot2 AOP starter，沿用 common-core 的 Boot4 AspectJ。 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-aop</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.com.nla</groupId>
            <artifactId>nla-common-sensitive</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../script/sql</directory>
                <includes><include>nla_callcenter.sql</include></includes>
                <filtering>false</filtering>
            </testResource>
        </testResources>
    </build>
</project>
